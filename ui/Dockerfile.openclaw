# Blitzscale OS — Custom OpenClaw Gateway
# Extends the official OpenClaw gateway with GTM Engine skill layer
#
# Build: docker build -f Dockerfile.openclaw -t blitzscale-openclaw .
# Run:   docker run -p 18789:18789 --env-file .env blitzscale-openclaw

FROM ghcr.io/openclaw/openclaw:2026.3.2

# Copy gateway configuration
COPY openclaw/openclaw.json /app/openclaw.json

# Copy GTM Engine skill into a non-volume path
COPY openclaw/skills/gtm-engine/ /app/blitzscale-skills/gtm-engine/

# Environment defaults (overridden per-company at runtime)
ENV OPENCLAW_CONFIG_PATH=/app/openclaw.json
ENV OPENCLAW_STATE_DIR=/data
ENV NODE_ENV=production

# Gateway port
EXPOSE 18789

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:18789/healthz').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
