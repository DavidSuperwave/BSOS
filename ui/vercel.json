{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/bsos-failure-check",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/bsos-full-sync",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/cron/bsos-eod",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/bsos-decay",
      "schedule": "0 3 1 * *"
    },
    {
      "path": "/api/cron/skills-no-active-campaign",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/report-automations",
      "schedule": "*/15 * * * *"
    }
  ]
}