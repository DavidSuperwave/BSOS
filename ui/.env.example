# ============================================
# Blitzscale OS — Environment Variables
# ============================================

# --------------------------------------------
# Supabase (Required)
# --------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public app URL used for auth email redirects (signup/reset password)
NEXT_PUBLIC_APP_URL=https://blitzscaleos.com

# --------------------------------------------
# OpenClaw Gateway (Required for agent features)
# --------------------------------------------
OPENCLAW_URL=http://localhost:18789
OPENCLAW_GATEWAY_TOKEN=your-gateway-token

# --------------------------------------------
# Supermemory (Required for agent memory)
# --------------------------------------------
SUPERMEMORY_API_KEY=sm_your-supermemory-api-key

# --------------------------------------------
# PlusVibe (Campaign Management)
# --------------------------------------------
PLUSVIBE_API_KEY=your-plusvibe-api-key
PLUSVIBE_WORKSPACE_ID=your-workspace-id

# --------------------------------------------
# Close CRM
# --------------------------------------------
CLOSE_API_KEY=your-close-api-key

# --------------------------------------------
# Calendly (Scheduling)
# --------------------------------------------
CALENDLY_API_KEY=your-calendly-api-key
CALENDLY_USER_URI=https://api.calendly.com/users/your-user-id

# --------------------------------------------
# Perplexity AI (Research)
# --------------------------------------------
PERPLEXITY_API_KEY=your-perplexity-api-key

# --------------------------------------------
# Inboxing (Domain Provisioning)
# --------------------------------------------
INBOXING_API_KEY=your-inboxing-api-key

# --------------------------------------------
# OpenRouter (AI Provider)
# --------------------------------------------
OPENROUTER_API_KEY=your-openrouter-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional when routing Anthropic-compatible traffic through OpenRouter:
# ANTHROPIC_BASE_URL=https://openrouter.ai/api/v1

# --------------------------------------------
# Container Provisioning (Required for Docker deployment)
# --------------------------------------------
DROPLET_IP=159.65.220.183
PROVISIONER_SSH_KEY=           # ed25519 private key contents
GHCR_IMAGE=ghcr.io/davidsuperwave/bsos/openclaw:latest
# PORT_RANGE_START=18790
# PORT_RANGE_END=18850

# --------------------------------------------
# Sentry (Error Monitoring — Optional)
# --------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/your-project-id
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project
# SENTRY_AUTH_TOKEN=your-auth-token

# ============================================
# Deployment Notes
# ============================================
#
# Docker (docker compose up):
#   - OPENCLAW_URL is set automatically to http://openclaw:18789
#   - Both services share the same OPENCLAW_GATEWAY_TOKEN and SUPERMEMORY_API_KEY
#
# Railway:
#   - Deploy as Docker service (uses Dockerfile)
#   - Add OpenClaw as separate service from ghcr.io/openclaw/gateway:latest
#   - Set OPENCLAW_URL to the internal Railway URL of the OpenClaw service
#   - All other vars go in Railway environment settings
#
# Required: NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
#           SUPABASE_SERVICE_ROLE_KEY, OPENCLAW_GATEWAY_TOKEN, SUPERMEMORY_API_KEY
# Optional: Everything else (features degrade gracefully without them)
