# Close CRM API Key
CLOSE_API_KEY=api_YOUR_CLOSE_API_KEY_HERE

# PlusVibe
PLUSVIBE_API_KEY=your_plusvibe_api_key
PLUSVIBE_WORKSPACE_ID=your_workspace_id

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Supermemory
SUPERMEMORY_API_KEY=your_supermemory_api_key

# Inboxing
INBOXING_API_KEY=your_inboxing_api_key

# Perplexity
PERPLEXITY_API_KEY=your_perplexity_api_key

# Calendly
CALENDLY_API_KEY=your_calendly_api_key
CALENDLY_EVENT_TYPE_UUID=your_event_type_uuid

# OOO Subsequence mapping (optional, format: parentCampaignId1:subId1,parentCampaignId2:subId2)
# OOO_SUBSEQUENCE_MAP=

# OpenClaw (local agent runtime)
OPENCLAW_URL=http://localhost:18789
OPENCLAW_GATEWAY_TOKEN=your_gateway_token

# Telegram Bot (optional - for notifications)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Sentry (optional)
SENTRY_DSN=your_sentry_dsn

# Server port
PORT=3000
